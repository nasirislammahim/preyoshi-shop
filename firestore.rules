rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'nasirislammahimbd@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Admins Collection ---
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().role == 'customer';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == existing().role) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Cart Subcollection
      match /cart/{cartItemId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Wishlist Subcollection
      match /wishlist/{wishlistId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // --- Categories Collection ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Products Collection ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Reviews Collection ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // --- Coupons Collection ---
    match /coupons/{couponCode} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Banners Collection ---
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Settings Collection ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Notifications Collection ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      // Customers can get their own orders; guests can view with exact document lookup; admins can view all
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if incoming().customerName is string && incoming().customerName.size() > 0 &&
        incoming().customerPhone is string && incoming().customerPhone.size() > 0 &&
        incoming().grandTotal is number && incoming().grandTotal >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Connection test collection for initialization sanity check ---
    match /test/{docId} {
      allow read: if true;
    }
  }
}
